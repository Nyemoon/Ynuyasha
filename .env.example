# Chave da Groq (opcional — sem ela, o agente usa o fallback local do Ollama).
# Copie este arquivo para .env e preencha o valor.
GROQ_API_KEY=

# Modelo e temperatura da Groq (padrões usados quando ausentes).
# O llama-3.3-70b-versatile foi desativado em 08/2026; os substitutos
# recomendados são openai/gpt-oss-120b e qwen/qwen3.6-27b.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.3

# Esforço de raciocínio para os modelos reasoning da Groq.
# Valores aceitos: low, medium, high (e "none"/off quando suportado).
# Quanto maior, melhor a qualidade, porém maior a latência por resposta.
GROQ_REASONING_EFFORT=low

# Limiar mínimo de relevância para o retriever (score 0.0-1.0). Perguntas
# cujo melhor trecho fique abaixo deste valor são tratadas como fora da base.
RAG_LIMIAR_RELEVANCIA=0.65

# Registra cada turno do agente em data/avaliacao/turnos_log.csv.
# Use true para ativar; false (padrão) mantém o comportamento silencioso.
YNUYASHA_LOG_TURNOS=false

# Modelo de fallback de geração via Ollama (usado quando GROQ_API_KEY está
# ausente ou quando a Groq falha). O padrão é smollm2:360m. Para trocar,
# baixe outro modelo local (ex.: `ollama pull qwen2.5:3b`) e descomente a
# linha abaixo alterando o valor. Os embeddings continuam usando nomic-embed-text.
OLLAMA_FALLBACK_MODEL=smollm2:360m

# Variáveis de conexão com Ollama (usadas quando não há chave Groq ou para
# conexão direta com o host). O host.docker.internal funciona apenas dentro
# de containers Docker; em desenvolvimento local use http://localhost:11434.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
